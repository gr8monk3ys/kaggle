# Secrets
kaggle.json
**/kaggle.json
.kaggle/
# A browser session file can carry login cookies
*_storage_state.json

# Browser automation runtime artifacts
.playwright-cli/
.playwright-mcp/

# Python
__pycache__/
*.py[cod]
.venv/
.coverage
catboost_info/

# Jupyter
.ipynb_checkpoints/

# Medal ops reports stay local; the snapshot history is committed
medal_ops/reports/
.competition_lab/

.env

# Dataset CSVs are build output: regenerate with ./manage.sh build-datasets.
# A dataset of real, fetched data cannot be rebuilt, so its CSV is source.
datasets/*/*.csv
!datasets/github-ml-repos/*.csv
