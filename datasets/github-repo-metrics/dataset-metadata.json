{
  "title": "GitHub Repository Metrics Dataset (5K+ Repos)",
  "id": "lorenzoscaturchio/github-repo-metrics",
  "subtitle": "5.5K repos with stars, forks, issues, CI/CD, and health signals",
  "description": "5,500 synthetic GitHub repositories across 12 programming languages with 29 features covering popularity, activity, and project-health signals. The table combines stars, forks, watchers, issues, pull requests, contributors, releases, CI/CD presence, test coverage, repository governance, and topic metadata in a single CSV.\n\nBuilt for star prediction, repository-health scoring, dormant-vs-active classification, language ecosystem analysis, and software engineering research. It is large enough for meaningful tabular modeling while staying compact enough for fast Kaggle notebook iteration.\n\nNotable properties: realistic correlations between popularity and maintenance signals, sparse test coverage when CI is absent, and topic strings that support lightweight NLP or tagging experiments. All data is synthetic.",
  "licenses": [
    {
      "name": "GPL-3.0"
    }
  ],
  "keywords": [
    "software",
    "programming",
    "regression",
    "classification",
    "beginner",
    "internet",
    "data analytics",
    "tabular",
    "exploratory data analysis"
  ],
